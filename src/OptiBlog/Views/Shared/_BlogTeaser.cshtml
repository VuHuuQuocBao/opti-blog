@model BlogTeaserViewModel
@{
    var post = Model.Post;
}
<article class="post-card">
    @if (!string.IsNullOrWhiteSpace(Model.Kicker))
    {
        <p class="post-card__kicker">@Model.Kicker</p>
    }
    <h2 class="post-card__title"><a href="@Url.ContentUrl(post.ContentLink)">@post.GetTitle()</a></h2>
    <p class="post-meta">
        <time datetime="@post.GetPublishDate().ToString("yyyy-MM-dd")">@post.GetPublishDate().ToString("d MMM yyyy")</time>
        @if (!string.IsNullOrWhiteSpace(post.Author))
        {
            <span>· by @post.Author</span>
        }
    </p>
    @if (!string.IsNullOrWhiteSpace(post.Summary))
    {
        <p>@post.Summary</p>
    }
</article>
