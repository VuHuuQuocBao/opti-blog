<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>5bacdaba-f0dc-4e7e-b82c-169f5f55a3c3</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="EPiServer" />
    <Using Include="EPiServer.Core" />
    <Using Include="EPiServer.DataAbstraction" />
    <Using Include="EPiServer.DataAnnotations" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="EPiServer.CMS" Version="13.4.0" />
    <PackageReference Include="EPiServer.Cms.UI.AspNetIdentity" Version="13.4.0" />
    <PackageReference Include="Optimizely.Graph.Cms" Version="13.4.0" />
    <PackageReference Include="Optimizely.Graph.Cms.Query" Version="13.4.0" />
  </ItemGroup>
  
  <ItemGroup>
    <EmbeddedResource Include="Resources\Translations\**\*" />
  </ItemGroup>
</Project>
